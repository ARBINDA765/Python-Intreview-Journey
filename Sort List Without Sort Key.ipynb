   "source": [
    "#Sort the list without sort key word\n",
    "a=[1,10,100,9,20]\n",
    "for i in range(0,len(a)):\n",
    "    for j in range(i+1,len(a)):\n",
    "        if a[i] >= a[j]:\n",
    "            a[i],a[j] = a[j],a[i]\n",
    "            "
   ]
