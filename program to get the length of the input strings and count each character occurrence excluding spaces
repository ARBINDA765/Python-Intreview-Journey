   "source": [
    "#Appraoch Solution 2\n",
    "#without using counter\n",
    "def string_length_and_char_count_1(input_string):\n",
    "    char_count = {}\n",
    "    length = 0\n",
    "    for char in input_string.replace(\" \", \"\"):\n",
    "        length += 1\n",
    "        char_count[char] = char_count.get(char, 0) + 1\n",
    "    return length, char_count"
   ]
