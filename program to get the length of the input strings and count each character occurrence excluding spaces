   "source": [
    "Write a Python program to get the length of the input strings and count each character occurrence excluding spaces:\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "8a2da26c-4775-4da1-90dc-6d6c74fdc047",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Approach Solution-1\n",
    "input_string=\"abc abc zx\"\n",
    "from collections import Counter\n",
    "counter=Counter(input_string)\n",
    "def string_length_and_char_count(input_string):\n",
    "    counter=Counter(input_string)\n",
    "    total_length=[value for key,value in counter.items() if not key==\" \"]\n",
    "    char_count=[{key,value}for key,value in counter.items() if not key==\" \"]\n",
    "    return sum(total_length),char_count\n",
    "    "
   ]
  },
